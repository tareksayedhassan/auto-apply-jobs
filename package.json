{
  "name": "openapply",
  "version": "0.1.0",
  "description": "Free, local, open-source job-search agent toolkit: search live roles, tailor resumes, fill and submit applications with your approval, track your pipeline. Works as an MCP server in Claude Code, Codex, Cursor and more.",
  "type": "module",
  "license": "MIT",
  "author": "Noel Turlington",
  "homepage": "https://noelturlington.xyz/openapply/",
  "repository": { "type": "git", "url": "https://github.com/nturl/openapply.git" },
  "bugs": { "url": "https://github.com/nturl/openapply/issues" },
  "keywords": ["mcp", "job-search", "claude-code", "ai-agent", "playwright"],
  "bin": { "openapply": "dist/cli.js", "openapply-mcp": "dist/mcp.js" },
  "files": ["dist", "data", "templates", "ui", "examples"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "mcp": "tsx src/mcp.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
